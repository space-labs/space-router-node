[Unit]
Description=Space Router Home Node
Documentation=https://github.com/space-labs/space-router-node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spacerouter
Group=spacerouter
WorkingDirectory=/var/lib/spacerouter
ExecStart=/opt/spacerouter/space-router-node
EnvironmentFile=-/etc/spacerouter/spacerouter.env

# v1.5 unified all provider state under ~/.spacerouter (settings.json,
# identity.key, receipts.db, daemon.lock). The systemd `spacerouter`
# service user has no real $HOME, so we point HOME at /var/lib/spacerouter
# and grant write access there. ProtectHome=yes keeps /home and /root
# inaccessible (defence in depth) — it does NOT block /var/lib.
Environment=HOME=/var/lib/spacerouter

# Restart on failure with increasing backoff
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# File descriptor limits (match launchd plist)
LimitNOFILE=4096

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=space-router-node

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/spacerouter /var/lib/spacerouter
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
