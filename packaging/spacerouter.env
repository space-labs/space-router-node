# Space Router Home Node — first-start seed file.
#
# The systemd unit reads this file via EnvironmentFile= on each start.
# On the very first start the daemon converts the SR_* values below into
# /var/lib/spacerouter/.spacerouter/settings.json (the v1.5 canonical
# config). After that, settings.json is the source of truth — edit it
# directly. The values below are still picked up as overrides on every
# start, so leave anything you want to lock at the .env layer (e.g.
# log level for ops scripts) and clear anything you want owned by
# settings.json.
#
# See: https://github.com/space-labs/space-router-node

# Required: EVM staking wallet address (0x followed by 40 hex chars).
# Without this the daemon cannot register or earn rewards.
SR_STAKING_ADDRESS=

# Optional: separate collection wallet for rewards. Defaults to
# SR_STAKING_ADDRESS when blank.
# SR_COLLECTION_ADDRESS=

# Optional: human-readable label shown in operator dashboards.
SR_NODE_LABEL=

# Listening port (1-65535). 9090 is the default.
SR_NODE_PORT=9090

# Optional: override auto-detected public IP (set this when you front
# the node with a tunnel like bore.pub or your own SNI router).
# SR_PUBLIC_IP=

# UPnP auto port-forwarding. Disable when the port is forwarded
# manually on the router.
SR_UPNP_ENABLED=true

# mTLS: require gateway to present a valid client certificate. Leave
# enabled in production. Useful to flip off temporarily during initial
# setup if you suspect a cert mismatch.
SR_MTLS_ENABLED=true

# Coordination API URL. Defaults to the production endpoint baked into
# the binary if blank — only set this when pointing at a custom or
# test coordination service.
# SR_COORDINATION_API_URL=

# Log level: DEBUG, INFO, WARNING, ERROR
SR_LOG_LEVEL=INFO
